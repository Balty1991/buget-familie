<?xml version="1.0" encoding="utf-8"?>
<!--
  Rădăcinile pe care FileProvider-ul aplicației are voie să le partajeze.
  Fără intrarea potrivită, `Share` aruncă „Failed to find configured root”
  și foaia de partajare nu se mai deschide deloc — exact felul de eșec tăcut
  care a făcut butonul de backup să pară că nu funcționează.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Doar folderele în care aplicația chiar scrie (Documente, Descărcări), nu tot spațiul extern. -->
    <external-path name="documents" path="Documents/" />
    <external-path name="downloads" path="Download/" />
    <cache-path name="my_cache_images" path="." />
    <files-path name="app_files" path="." />
    <external-files-path name="app_external_files" path="." />
    <external-cache-path name="app_external_cache" path="." />
</paths>
