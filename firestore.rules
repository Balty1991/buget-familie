rules_version = '2';

// Reguli Firestore pentru Buget Familie — de lipit în Firebase Console →
// Firestore Database → Rules, exact așa cum sunt aici.
//
// Fiecare familie are propriul document, ale cărui ID este un hash SHA-256
// al parolei ei de familie (client-ul îl calculează, nu-l trimite niciodată
// pe cel în clar). Oricine nu cunoaște parola nu poate ghici sau enumera
// ID-ul; conținutul propriu-zis este oricum criptat AES-GCM înainte să
// ajungă aici, așa că Firestore nu vede niciodată date financiare în clar.
// App Check: poți activa pe proiect pentru anti-abuz, dar NU pune Enforce pe Firestore
// până confirmi că build-ul publicat trimite token (altfel blochezi familiile existente).
// Regulile de mai jos rămân pe get/create/update — fără list/delete.
service cloud.firestore {
  match /databases/{database}/documents {
    function envelopeWriteOk() {
      return request.resource.data.keys().hasOnly(['envelope', 'updatedAt'])
        && request.resource.data.envelope.keys().hasOnly(['version', 'createdAt', 'salt', 'iv', 'ciphertext'])
        && request.resource.data.envelope.version == 1
        && request.resource.data.envelope.ciphertext is string
        && request.resource.data.envelope.ciphertext.size() < 2000000
        && request.resource.data.envelope.salt is string
        && request.resource.data.envelope.salt.size() == 24
        && request.resource.data.envelope.iv is string
        && request.resource.data.envelope.iv.size() == 16;
    }

    match /familySync/{roomId} {
      // `get`, nu `read`: `read` acoperă și interogarea colecției, așa că oricine
      // putea descărca pachetele criptate ale tuturor familiilor și le putea ataca
      // offline. Un `get` cere ID-ul camerei, adică deja cunoașterea parolei.
      allow get: if roomId.size() == 64;
      // `create, update`, nu `write`: `write` acoperă și `delete`, deci oricine
      // ajungea la ID-ul camerei putea șterge pachetul familiei dintr-o singură
      // cerere. Nu există niciun motiv legitim ca aplicația să șteargă documentul —
      // o familie care vrea să se retragă schimbă parola, iar camera veche rămâne
      // orfană. Ce poate face cineva rămâne astfel „strică”, nu „distruge”.
      allow create, update: if roomId.size() == 64 && envelopeWriteOk();
    }

    // Cod de recuperare: același format de pachet, ID derivat din cod (nu din parolă).
    // Serverul vede doar parola de familie deja criptată cu codul. Fără list/delete.
    match /familyRecovery/{recoveryId} {
      allow get: if recoveryId.size() == 64;
      allow create, update: if recoveryId.size() == 64 && envelopeWriteOk();
    }

    // Contor de abuz pentru ghidul online. Doar Admin SDK scrie aici.
    match /aiGuideQuota/{id} {
      allow read, write: if false;
    }
  }
}
